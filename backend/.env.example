# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/servicedesk-pro

# Auth
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS - comma-separated frontend origins
CLIENT_URL=http://localhost:5173

# AI Provider - "groq", "gemini", or "none"
AI_PROVIDER=none
GROQ_API_KEY=
GEMINI_API_KEY=
